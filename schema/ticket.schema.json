{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aufträge (data/tickets.json)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "from", "node", "scenario", "task"],
    "$defs": { "lines": { "type": "array", "items": { "type": "array", "prefixItems": [{ "type": "string", "description": "Figur aus story.json" }, { "type": "string" }] } } },
    "properties": {
      "id": { "type": "string" },
      "title": { "type": "string" },
      "from": { "type": "string", "description": "Figur aus story.json/characters" },
      "node": { "type": "string", "description": "Ort aus map.json/nodes" },
      "requires": { "type": "array", "items": { "type": "string" }, "description": "erst freigeschaltet, wenn diese Tickets erledigt sind" },
      "reward": { "type": "number", "description": "Euro; halbiert bei Fehlversuchen" },
      "scenario": { "description": "id aus data/scenarios/ oder Szenario direkt als Objekt" },
      "intro": { "$ref": "#/items/$defs/lines" },
      "success": { "$ref": "#/items/$defs/lines" },
      "task": {
        "type": "object", "required": ["type"],
        "properties": {
          "type": { "enum": ["match"], "description": "weitere Typen folgen (calc, describe, axes, …)" },
          "actor": { "type": "string" },
          "given": { "type": "array", "items": { "enum": ["anim", "xt", "vt", "at", "yt", "vyt", "ayt"] } },
          "ask": { "enum": ["xt", "vt", "at", "yt", "vyt", "ayt"] },
          "prompt": { "type": "string" },
          "paper": { "type": "string", "description": "Notizzettel: was auf Papier gerechnet wird" },
          "prefer": { "type": "array", "items": { "type": "string" }, "description": "bevorzugte Distraktoren aus distractors.js/CATALOG" },
          "goals": { "type": "array", "description": "für Rechenaufgaben: Goals aus js/engine/goals.js" }
        }
      }
    }
  }
}
